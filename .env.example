APP_NAME="CypressIQ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL Database Settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_cypressiq
DB_USERNAME=u123456789_cypressiq
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Initial Admin Seeding Credentials
ADMIN_EMAIL=admin@cypressiq.agency
ADMIN_PASSWORD=your_secure_admin_password

# Hostinger Mail / SMTP Settings (e.g. Titan Mail, Google Workspace, or SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USERNAME=hello@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# REAL-TIME INSTANT LEAD ALERTS (Telegram, Discord, Webhooks)
# ==============================================================================
# 1. Telegram Bot Alerts:
# Create a bot with @BotFather on Telegram, paste its token below.
# Get your Telegram Chat/User ID with @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook Alerts:
# In your Discord Server: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# 3. Generic Webhook (e.g. Slack / Zapier / Make.com):
LEAD_WEBHOOK_URL=

